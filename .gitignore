# Local-only, never committed to the public repository
/reference/
/docs/IMPLEMENTATION_PLAN.md

# Dependencies
node_modules/

# Next.js / build output
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Testing (Istanbul/Vitest HTML reports). Do not ignore the Admin SEC coverage route.
coverage/
!apps/web/src/app/admin/coverage/
!apps/web/src/app/admin/coverage/**

# Local cache of downloaded source files (raw SEC data is never committed)
.cache/

# Local pipeline store: content-addressed SEC bytes, fetch log, never committed
.data/

# Environment files (examples are placeholders; .env.local stays untracked)
.env
.env.*
!.env.example
!.env.local.example

# Vercel
.vercel/

# Cursor: only shared project rules are tracked; personal config (MCP servers, etc.) is not
/.cursor/*
!/.cursor/rules/
.cursor/mcp.json

# Logs
npm-debug.log*

# OS / editor
.DS_Store

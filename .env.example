# BDC Intelligence — environment variables
#
# Copy to .env.local for local development. Never commit real values.

# Database connection string (introduced in a later phase; not read by any code yet)
# DATABASE_URL=

# Contact identification for automated SEC EDGAR access: a project name followed by a real
# contact email. Read by `npm run sec:fetch` and `npm run registry:fetch`, which refuse to
# run without it. Set it only in .env.local; the value is never logged or written to the
# repository.
# SEC_USER_AGENT=
